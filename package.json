{
  "name": "@bunyan/design-system",
  "version": "0.0.1",
  "private": true,
  "description": "Accessible React Native design system for iOS, Android, and web.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "sideEffects": [
    "./src/design-system/validation/yup.ts",
    "./dist/design-system/validation/yup.js"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "docs",
    "!docs/*.pdf"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "storybook": "npm --prefix showcase start",
    "storybook:ios": "npm --prefix showcase run ios",
    "storybook:android": "npm --prefix showcase run android",
    "storybook:web": "npm --prefix showcase run web",
    "prepack": "npm run clean && npm run build",
    "pack": "npm i && npm pack",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "yup": "^1.7.1"
  },
  "peerDependencies": {
    "@react-native-community/datetimepicker": ">=8.0.0",
    "formik": ">=2.2.0",
    "react": ">=18.2.0",
    "react-native": ">=0.74.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@storybook/addon-ondevice-actions": "^10.4.6",
    "@storybook/addon-ondevice-controls": "^10.4.6",
    "@storybook/react-native": "^10.4.6",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.8",
    "babel-jest": "^29.7.0",
    "formik": "^2.4.9",
    "jest": "^29.7.0",
    "react": "19.3.0",
    "react-native": "^0.86.0",
    "react-native-svg": "^15.12.1",
    "react-test-renderer": "19.3.0",
    "storybook": "^10.4.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}

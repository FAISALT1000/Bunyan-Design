{
  "name": "@bunyan/design-system",
  "version": "0.0.1",
  "private": true,
  "description": "Accessible React Native design system for iOS, Android, and web.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.js",
  "sideEffects": false,
  "files": [
    "dist",
    "scripts",
    "README.md",
    "docs"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "node ./scripts/lint-source.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "storybook": "npm --prefix showcase start",
    "storybook:ios": "npm --prefix showcase run ios",
    "storybook:android": "npm --prefix showcase run android",
    "storybook:web": "npm --prefix showcase run web",
    "package": "node ./scripts/generate-package.mjs patch",
    "package:patch": "node ./scripts/generate-package.mjs patch",
    "package:minor": "node ./scripts/generate-package.mjs minor",
    "package:major": "node ./scripts/generate-package.mjs major",
    "package:dry-run": "node ./scripts/generate-package.mjs patch --dry-run",
    "GP": "nvm use && npm i && npm pack"
  },
  "peerDependencies": {
    "@react-native-community/datetimepicker": ">=8.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.77.0",
    "react-native-safe-area-context": ">=4.10.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native/babel-preset": "0.80.3",
    "@react-native/jest-preset": "0.86.0",
    "@storybook/addon-ondevice-actions": "^10.4.6",
    "@storybook/addon-ondevice-controls": "^10.4.6",
    "@storybook/react-native": "^10.4.6",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.8",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "^19.1.1",
    "react-native": "^0.86.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "^15.12.1",
    "react-test-renderer": "^19.2.3",
    "storybook": "^10.4.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "dependencies": {
    "i18n-js": "^4.5.3"
  }
}

{
  "name": "@bunyan/showcase",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@bunyan/design-system": "file:..",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@storybook/react-native": "10.4.6",
    "expo": "~56.0.12",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "storybook": "10.4.6"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prestart": "node scripts/check-node.cjs",
    "start": "expo start --clear",
    "preview": "EXPO_PUBLIC_SHOWCASE_ENTRY=preview expo start --clear",
    "preview:web": "EXPO_PUBLIC_SHOWCASE_ENTRY=preview expo start --web --clear",
    "preview:android": "EXPO_PUBLIC_SHOWCASE_ENTRY=preview expo start --android --clear",
    "preview:apk": "node scripts/build-preview-apk.cjs",
    "storybook": "EXPO_PUBLIC_SHOWCASE_ENTRY=storybook expo start --clear",
    "storybook:web": "EXPO_PUBLIC_SHOWCASE_ENTRY=storybook expo start --web --clear",
    "preandroid": "node scripts/check-node.cjs",
    "android": "expo start --android --clear",
    "preios": "node scripts/check-node.cjs",
    "ios": "expo start --ios --clear",
    "preweb": "node scripts/check-node.cjs",
    "web": "expo start --web --clear",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25"
  },
  "private": true
}
